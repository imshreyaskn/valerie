# ── App ───────────────────────────────────────────
APP_ENV=development

# ── Databases ─────────────────────────────────────
MONGO_URI=mongodb://valerie:localdev@mongodb:27017/valerie_db?authSource=admin
REDIS_URI=redis://redis:6379
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/valerie_db   # optional (alembic)

# ── Security (REQUIRED — min 32 chars, generate with: openssl rand -hex 32) ──
VALERIE_MASTER_KEY=change-me-generate-a-unique-64-hex-char-secret
JWT_SECRET_KEY=change-me-generate-a-unique-64-hex-char-secret
WORKER_SECRET=change-me-generate-a-unique-64-hex-char-secret

# Explicit opt-in for localhost LLM targets in local dev. MUST be false/unset in production.
ALLOW_LOCAL_LLM_TARGETS=false

# ── Platform LLM keys (attacker defaults; rotate immediately if leaked) ──
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── CORS ──────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ── GCP (Cloud Tasks dispatch; optional — BackgroundTasks fallback used otherwise) ──
GCP_PROJECT_ID=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=valerie-pipeline-queue
WORKER_URL=http://worker:8081/internal/run
WORKER_USE_CLOUD_TASKS=false
