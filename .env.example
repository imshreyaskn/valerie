# ── App ───────────────────────────────────────────
APP_ENV=development

# ── Database (Neon) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://valerie:localdev@db:5432/valerie_db

# ── Platform LLM (for attacker default) ──────────
PLATFORM_MISTRAL_KEY=your_mistral_key_here
PLATFORM_DEFAULT_ATTACKER_MODEL=mistral/mistral-large-latest

# ── Security ──────────────────────────────────────
VALERIE_MASTER_KEY=32-byte-base64-fernet-key
API_KEY_SALT=random-bcrypt-salt

# ── GCP ───────────────────────────────────────────
GCP_PROJECT_ID=valerie-redteam
GCP_REGION=us-central1
CLOUD_TASKS_QUEUE=valerie-pipeline-queue
WORKER_URL=http://worker:8081/internal/run
