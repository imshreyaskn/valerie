# Demo configuration — local-only credentials, safe defaults.
# Copy to .env before running docker-compose up --build.

# ── App ───────────────────────────────────────────
APP_ENV=development

# ── Databases (docker-compose services) ───────────
MONGO_URI=mongodb://valerie:localdev@mongodb:27017/valerie_db?authSource=admin
REDIS_URI=redis://redis:6379
DATABASE_URL=postgresql+asyncpg://valerie:localdev@db:5432/valerie_db

# ── Security (demo-grade; replace for any shared deployment) ──
VALERIE_MASTER_KEY=demo-master-key-0123456789abcdef0123456789abcdef
JWT_SECRET_KEY=demo-jwt-key-0123456789abcdef0123456789abcdef
WORKER_SECRET=demo-worker-secret-0123456789abcdef01234567

ALLOW_LOCAL_LLM_TARGETS=true

# ── Platform LLM keys (paste your own demo keys) ──
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── GCP ───────────────────────────────────────────
WORKER_USE_CLOUD_TASKS=false
