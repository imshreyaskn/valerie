# Copy this to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git

project_id        = "your-gcp-project-id"
region            = "us-central1"

# From Supabase: Settings > Database > Connection string (Transaction mode, port 6543)
# Change postgres:// to postgresql+asyncpg://
supabase_db_url   = "postgresql+asyncpg://postgres.[ref]:[password]@[host]:6543/postgres"

# Generate with: openssl rand -hex 32
valerie_master_key = "your-random-32-char-master-key"
api_key_salt       = "your-random-salt-string"

# Optional: default platform key (users BYOK for LLM calls)
mistral_api_key    = ""

image_tag          = "latest"
